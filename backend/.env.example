# Copie para .env e ajuste. Padrões apontam para Ollama local (gratuito).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# Ollama local é lento (~29 s medidos); o site público usa o padrão de 8 s.
LLM_TIMEOUT_S=45
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGENS=["http://localhost:3000"]
